{
  "name": "entroq",
  "version": "0.13.0",
  "description": "EntroQ workers through the work gateway (eqlink work)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.browser.json"
  },
  "keywords": [
    "entroq",
    "task",
    "queue"
  ],
  "author": "Chris Monson <shiblon@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiblon/entroq.git",
    "directory": "clients/js"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  },
  "engines": {
    "node": ">=20"
  }
}
